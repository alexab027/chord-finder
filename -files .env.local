[1m+++ b/app/api/interpret-style/route.ts[m
[36m@@ -0,0 +1,182 @@[m
[32m+[m[32mimport Groq from "groq-sdk";[m
[32m+[m[32mimport {[m
[32m+[m[32m  ALLOWED_STYLES,[m
[32m+[m[32m  DEFAULT_INTERPRETED_STYLE,[m
[32m+[m[32m  type InterpretedStyle,[m
[32m+[m[32m} from "@/src/ai/types";[m
[32m+[m[32mimport type { StyleOption } from "@/src/music/types";[m
[32m+[m
[32m+[m[32mconst MAX_PROMPT_LENGTH = 500;[m
[32m+[m[32mconst MAX_SUMMARY_LENGTH = 240;[m
[32m+[m[32mconst MAX_MOOD_ITEMS = 5;[m
[32m+[m[32mconst MAX_MOOD_LENGTH = 40;[m
[32m+[m
[32m+[m[32mtype InterpretResponse = InterpretedStyle & { warning?: string };[m
[32m+[m
[32m+[m[32mconst SYSTEM_PROMPT = `You translate a musician's plain-English description of the harmony they want into a small JSON settings object. You do NOT compose music.[m
[32m+[m
[32m+[m[32mRules:[m
[32m+[m[32m- Return ONLY a JSON object. No prose, no markdown.[m
[32m+[m[32m- "primaryStyle" must be exactly one of: "simple", "jazzy", "bluesy", "descendingBass". Use no other value.[m
[32m+[m[32m- Do not return chord names. Do not generate a progression.[m
[32m+[m[32m- Map simple / pop / clean / basic language toward "simple".[m
[32m+[m[32m- Map jazz / lush / sophisticated / colorful language toward "jazzy".[m
[32m+[m[32m- Map blues / gritty / dominant-seventh language toward "bluesy".[m
[32m+[m[32m- Increase "descendingBassWeight" for falling, walking-down, or descending bass requests.[m
[32m+[m[32m- Lower "dissonanceTolerance" for safe, smooth, or consonant requests.[m
[32m+[m[32m- Raise "dissonanceTolerance" for tense, surprising, or experimental requests.[m
[32m+[m[32m- Raise "cadenceStrength" for resolved, satisfying, or strong-ending requests.[m
[32m+[m
[32m+[m[32mAll numeric fields are between 0 and 1. Respond with exactly this shape:[m
[32m+[m[32m{[m
[32m+[m[32m  "primaryStyle": "simple",[m
[32m+[m[32m  "descendingBassWeight": 0.0,[m
[32m+[m[32m  "complexity": 0.0,[m
[32m+[m[32m  "dissonanceTolerance": 0.0,[m
[32m+[m[32m  "cadenceStrength": 0.0,[m
[32m+[m[32m  "preferSevenths": false,[m
[32m+[m[32m  "preferSuspensions": false,[m
[32m+[m[32m  "mood": [],[m
[32m+[m[32m  "summary": ""[m
[32m+[m[32m}`;[m
[32m+[m
[32m+[m[32mfunction clamp01(value: unknown, fallback: number): number {[m
[32m+[m[32m  if (typeof value !== "number" || !Number.isFinite(value)) return fallback;[m
[32m+[m[32m  return Math.min(1, Math.max(0, value));[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction asBoolean(value: unknown, fallback: boolean): boolean {[m
[32m+[m[32m  return typeof value === "boolean" ? value : fallback;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction asStyle(value: unknown): StyleOption {[m
[32m+[m[32m  return ALLOWED_STYLES.includes(value as StyleOption)[m
[32m+[m[32m    ? (value as StyleOption)[m
[32m+[m[32m    : DEFAULT_INTERPRETED_STYLE.primaryStyle;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction asMood(value: unknown): string[] {[m
[32m+[m[32m  if (!Array.isArray(value)) return [];[m
[32m+[m[32m  return value[m
[32m+[m[32m    .filter((item): item is string => typeof item === "string")[m
[32m+[m[32m    .map((item) => item.trim().slice(0, MAX_MOOD_LENGTH))[m
[32m+[m[32m    .filter((item) => item.length > 0)[m
[32m+[m[32m    .slice(0, MAX_MOOD_ITEMS);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction asSummary(value: unknown): string {[m
[32m+[m[32m  if (typeof value !== "string") return DEFAULT_INTERPRETED_STYLE.summary;[m
[32m+[m[32m  const trimmed = value.trim();[m
[32m+[m[32m  if (trimmed.length === 0) return DEFAULT_INTERPRETED_STYLE.summary;[m
[32m+[m[32m  return trimmed.slice(0, MAX_SUMMARY_LENGTH);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m// Coerce an arbitrary parsed object into a safe InterpretedStyle, substituting[m
[32m+[m[32m// defaults for anything missing or out of range.[m
[32m+[m[32mfunction sanitizeInterpretation(raw: unknown): InterpretedStyle {[m
[32m+[m[32m  const data = (raw ?? {}) as Record<string, unknown>;[m
[32m+[m[32m  return {[m
[32m+[m[32m    primaryStyle: asStyle(data.primaryStyle),[m
[32m+[m[32m    descendingBassWeight: clamp01([m
[32m+[m[32m      data.descendingBassWeight,[m
[32m+[m[32m      DEFAULT_INTERPRETED_STYLE.descendingBassWeight,[m
[32m+[m[32m    ),[m
[32m+[m[32m    complexity: clamp01(data.complexity, DEFAULT_INTERPRETED_STYLE.complexity),[m
[32m+[m[32m    dissonanceTolerance: clamp01([m
[32m+[m[32m      data.dissonanceTolerance,[m
[32m+[m[32m      DEFAULT_INTERPRETED_STYLE.dissonanceTolerance,[m
[32m+[m[32m    ),[m
[32m+[m[32m    cadenceStrength: clamp01([m
[32m+[m[32m      data.cadenceStrength,[m
[32m+[m[32m      DEFAULT_INTERPRETED_STYLE.cadenceStrength,[m
[32m+[m[32m    ),[m
[32m+[m[32m    preferSevenths: asBoolean([m
[32m+[m[32m      data.preferSevenths,[m
[32m+[m[32m      DEFAULT_INTERPRETED_STYLE.preferSevenths,[m
[32m+[m[32m    ),[m
[32m+[m[32m    preferSuspensions: asBoolean([m
[32m+[m[32m      data.preferSuspensions,[m
[32m+[m[32m      DEFAULT_INTERPRETED_STYLE.preferSuspensions,[m
[32m+[m[32m    ),[m
[32m+[m[32m    mood: asMood(data.mood),[m
[32m+[m[32m    summary: asSummary(data.summary),[m
[32m+[m[32m  };[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction json(body: InterpretResponse, status = 200): Response {[m
[32m+[m[32m  return Response.json(body, { status });[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mexport async function POST(request: Request): Promise<Response> {[m
[32m+[m[32m  let prompt = "";[m
[32m+[m
[32m+[m[32m  try {[m
[32m+[m[32m    const body = (await request.json()) as { prompt?: unknown };[m
[32m+[m[32m    prompt = typeof body?.prompt === "string" ? body.prompt.trim() : "";[m
[32m+[m[32m  } catch {[m
[32m+[m[32m    // Malformed JSON body: fall back to safe defaults rather than throwing.[m
[32m+[m[32m    return json({ ...DEFAULT_INTERPRETED_STYLE });[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  // Empty prompt: deterministic defaults, no Groq call.[m
[32m+[m[32m  if (prompt.length === 0) {[m
[32m+[m[32m    return json({ ...DEFAULT_INTERPRETED_STYLE });[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  // Reject overly long prompts, but keep a usable response shape.[m
[32m+[m[32m  if (prompt.length > MAX_PROMPT_LENGTH) {[m
[32m+[m[32m    return json([m
[32m+[m[32m      {[m
[32m+[m[32m        ...DEFAULT_INTERPRETED_STYLE,[m
[32m+[m[32m        warning: `Prompt exceeds ${MAX_PROMPT_LENGTH} characters; using default style.`,[m
[32m+[m[32m      },[m
[32m+[m[32m      400,[m
[32m+[m[32m    );[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  if (!process.env.GROQ_API_KEY) {[m
[32m+[m[32m    console.error("interpret-style: GROQ_API_KEY is not configured.");[m
[32m+[m[32m    return json({[m
[32m+[m[32m      ...DEFAULT_INTERPRETED_STYLE,[m
[32m+[m[32m      warning: "AI interpretation is not configured; using default style.",[m
[32m+[m[32m    });[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  const model = process.env.GROQ_MODEL ?? "llama-3.1-8b-instant";[m
[32m+[m
[32m+[m[32m  try {[m
[32m+[m[32m    const groq = new Groq({ apiKey: process.env.GROQ_API_KEY });[m
[32m+[m
[32m+[m[32m    const completion = await groq.chat.completions.create({[m
[32m+[m[32m      model,[m
[32m+[m[32m      temperature: 0,[m
[32m+[m[32m      max_completion_tokens: 300,[m
[32m+[m[32m      response_format: { type: "json_object" },[m
[32m+[m[32m      messages: [[m
[32m+[m[32m        { role: "system", content: SYSTEM_PROMPT },[m
[32m+[m[32m        { role: "user", content: prompt },[m
[32m+[m[32m      ],[m
[32m+[m[32m    });[m
[32m+[m
[32m+[m[32m    const content = completion.choices[0]?.message?.content;[m
[32m+[m[32m    if (!content) {[m
[32m+[m[32m      return json({[m
[32m+[m[32m        ...DEFAULT_INTERPRETED_STYLE,[m
[32m+[m[32m        warning: "AI interpretation was empty; using default style.",[m
[32m+[m[32m      });[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    const parsed = JSON.parse(content) as unknown;[m
[32m+[m[32m    return json(sanitizeInterpretation(parsed));[m
[32m+[m[32m  } catch (error) {[m
[32m+[m[32m    // Log server-side only; never leak the key or a stack trace to the client.[m
[32m+[m[32m    console.error([m
[32m+[m[32m      "interpret-style: Groq request failed:",[m
[32m+[m[32m      error instanceof Error ? error.message : "unknown error",[m
[32m+[m[32m    );[m
[32m+[m[32m    return json({[m
[32m+[m[32m      ...DEFAULT_INTERPRETED_STYLE,[m
[32m+[m[32m      warning: "AI interpretation was unavailable; using default style.",[m
[32m+[m[32m    });[m
[32m+[m[32m  }[m
[32m+[m[32m}[m
