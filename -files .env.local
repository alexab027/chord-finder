[1m--- /dev/null[m
[1m+++ b/planning.md[m
[36m@@ -0,0 +1,783 @@[m
[32m+[m[32m# AI Implementation Instructions: Groq-Powered Style Interpretation for Music Copilot[m
[32m+[m
[32m+[m[32m## Objective[m
[32m+[m
[32m+[m[32mModify the existing Music Copilot project so that:[m
[32m+[m
[32m+[m[32m1. The user can describe the desired harmony in natural language.[m
[32m+[m[32m2. A server-side Groq API route converts that description into validated, structured generation preferences.[m
[32m+[m[32m3. The existing deterministic music-theory engine remains responsible for selecting, scoring, voicing, and rendering the actual chords.[m
[32m+[m[32m4. The existing engine-generated reasons remain visible immediately.[m
[32m+[m[32m5. A separate optional Groq API route can rewrite those grounded reasons into a concise plain-English explanation.[m
[32m+[m[32m6. The app continues to work when Groq is unavailable by falling back to the existing style dropdown and deterministic engine.[m
[32m+[m
[32m+[m[32mDo not replace the music-theory engine with an LLM. Do not ask Groq to invent or directly choose chord progressions.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Existing Architecture to Preserve[m
[32m+[m
[32m+[m[32mThe project currently has these main layers:[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32msrc/components/Staff.tsx[m
[32m+[m[32m    React state, controls, VexFlow rendering, orchestration[m
[32m+[m
[32m+[m[32msrc/music/[m
[32m+[m[32m    Pure TypeScript music-theory engine[m
[32m+[m
[32m+[m[32msrc/audio/playback.ts[m
[32m+[m[32m    Tone.js scheduling and playback[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mPreserve the separation between UI, music logic, and audio.[m
[32m+[m
[32m+[m[32mBefore editing, inspect the actual types and function signatures in:[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32msrc/music/types.ts[m
[32m+[m[32msrc/music/chordScoring.ts[m
[32m+[m[32msrc/music/chordGeneration.ts[m
[32m+[m[32msrc/music/chords.ts[m
[32m+[m[32msrc/music/keyDetection.ts[m
[32m+[m[32msrc/components/Staff.tsx[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mAdapt all code to the real names already used in the repository. Do not blindly introduce duplicate types or parallel generation functions.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Required New Structure[m
[32m+[m
[32m+[m[32mCreate these files:[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32msrc/ai/types.ts[m
[32m+[m[32msrc/ai/toGenerationPreferences.ts[m
[32m+[m[32mapp/api/interpret-style/route.ts[m
[32m+[m[32mapp/api/explain-progression/route.ts[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mModify these existing files as needed:[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32msrc/music/types.ts[m
[32m+[m[32msrc/music/chordScoring.ts[m
[32m+[m[32msrc/music/chordGeneration.ts[m
[32m+[m[32msrc/components/Staff.tsx[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mDo not expose the Groq API key in client code.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m# Phase 1: Inspect the Existing Project[m
[32m+[m
[32m+[m[32mBefore making changes:[m
[32m+[m
[32m+[m[32m1. Locate the current `StyleOption`, `ChordQuality`, `ScoredChord`, `PlacedChord`, `KeyContext`, and scoring-context types.[m
[32m+[m[32m2. Locate the current `generateChords` function in `Staff.tsx`.[m
[32m+[m[32m3. Locate the current signature of `chooseProgression`.[m
[32m+[m[32m4. Locate where per-chord style scoring occurs.[m
[32m+[m[32m5. Locate where cadence/path scoring occurs.[m
[32m+[m[32m6. Locate the existing human-readable `reasons` fields.[m
[32m+[m[32m7. Locate the fields used to identify:[m
[32m+[m[32m   - chord symbol[m
[32m+[m[32m   - Roman numeral[m
[32m+[m[32m   - inversion[m
[32m+[m[32m   - bass pitch[m
[32m+[m[32m   - chord quality[m
[32m+[m[32m   - score[m
[32m+[m[32m8. Preserve existing behavior when no text prompt is supplied.[m
[32m+[m
[32m+[m[32mDo not proceed by guessing field names. Reuse the repository's actual domain model.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m# Phase 2: Add AI Domain Types[m
[32m+[m
[32m+[m[32mCreate:[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32msrc/ai/types.ts[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mDefine:[m
[32m+[m
[32m+[m[32m```ts[m
[32m+[m[32mimport type { StyleOption } from "@/src/music/types";[m
[32m+[m
[32m+[m[32mexport type InterpretedStyle = {[m
[32m+[m[32m  primaryStyle: StyleOption;[m
[32m+[m[32m  descendingBassWeight: number;[m
[32m+[m[32m  complexity: number;[m
[32m+[m[32m  dissonanceTolerance: number;[m
[32m+[m[32m  cadenceStrength: number;[m
[32m+[m[32m  preferSevenths: boolean;[m
[32m+[m[32m  preferSuspensions: boolean;[m
[32m+[m[32m  mood: string[];[m
[32m+[m[32m  summary: string;[m
[32m+[m[32m};[m
[32m+[m
[32m+[m[32mexport const DEFAULT_INTERPRETED_STYLE: InterpretedStyle = {[m
[32m+[m[32m  primaryStyle: "simple",[m
[32m+[m[32m  descendingBassWeight: 0,[m
[32m+[m[32m  complexity: 0.25,[m
[32m+[m[32m  dissonanceTolerance: 0.2,[m
[32m+[m[32m  cadenceStrength: 0.7,[m
[32m+[m[32m  preferSevenths: false,[m
[32m+[m[32m  preferSuspensions: false,[m
[32m+[m[32m  mood: [],[m
[32m+[m[32m  summary: "Use a clear, consonant progression with a strong resolution.",[m
[32m+[m[32m};[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mAdjust `"simple"` and all style names to exactly match the existing `StyleOption` union.[m
[32m+[m
[32m+[m[32mDo not weaken existing type safety with broad `string` types unless unavoidable.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m# Phase 3: Add Generation Preferences to the Music Engine[m
[32m+[m
[32m+[m[32mIn `src/music/types.ts`, add a type equivalent to:[m
[32m+[m
[32m+[m[32m```ts[m
[32m+[m[32mexport type GenerationPreferences = {[m
[32m+[m[32m  style: StyleOption;[m
[32m+[m[32m  descendingBassWeight: number;[m
[32m+[m[32m  complexity: number;[m
[32m+[m[32m  dissonanceTolerance: number;[m
[32m+[m[32m  cadenceStrength: number;[m
[32m+[m[32m  preferSevenths: boolean;[m
[32m+[m[32m  preferSuspensions: boolean;[m
[32m+[m[32m};[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mCreate:[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32msrc/ai/toGenerationPreferences.ts[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mImplement:[m
[32m+[m
[32m+[m[32m```ts[m
[32m+[m[32mimport type { InterpretedStyle } from "./types";[m
[32m+[m[32mimport type { GenerationPreferences } from "@/src/music/types";[m
[32m+[m
[32m+[m[32mexport function toGenerationPreferences([m
[32m+[m[32m  interpretation: InterpretedStyle,[m
[32m+[m[32m): GenerationPreferences {[m
[32m+[m[32m  return {[m
[32m+[m[32m    style: interpretation.primaryStyle,[m
[32m+[m[32m    descendingBassWeight: interpretation.descendingBassWeight,[m
[32m+[m[32m    complexity: interpretation.complexity,[m
[32m+[m[32m    dissonanceTolerance: interpretation.dissonanceTolerance,[m
[32m+[m[32m    cadenceStrength: interpretation.cadenceStrength,[m
[32m+[m[32m    preferSevenths: interpretation.preferSevenths,[m
[32m+[m[32m    preferSuspensions: interpretation.preferSuspensions,[m
[32m+[m[32m  };[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mUpdate the existing chord-scoring and progression-scoring context types so the preferences can reach both:[m
[32m+[m
[32m+[m[32m- per-chord scoring[m
[32m+[m[32m- bass-motion scoring[m
[32m+[m[32m- cadence/path scoring[m
[32m+[m
[32m+[m[32mKeep a backward-compatible default path so existing dropdown-based generation still works.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m# Phase 4: Build the Server-Side Style Interpretation Route[m
[32m+[m
[32m+[m[32mCreate:[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mapp/api/interpret-style/route.ts[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mUse `groq-sdk`.[m
[32m+[m
[32m+[m[32mThe route must:[m
[32m+[m
[32m+[m[32m1. Read a JSON body with a `prompt` string.[m
[32m+[m[32m2. Trim the prompt.[m
[32m+[m[32m3. Return defaults for an empty prompt.[m
[32m+[m[32m4. Reject prompts longer than 500 characters.[m
[32m+[m[32m5. Call Groq only on the server.[m
[32m+[m[32m6. Request JSON output.[m
[32m+[m[32m7. Parse and sanitize all returned values.[m
[32m+[m[32m8. Return safe defaults when Groq fails.[m
[32m+[m[32m9. Never leak the API key.[m
[32m+[m[32m10. Log server-side errors without sending stack traces to the client.[m
[32m+[m
[32m+[m[32mUse:[m
[32m+[m
[32m+[m[32m```ts[m
[32m+[m[32mconst groq = new Groq({[m
[32m+[m[32m  apiKey: process.env.GROQ_API_KEY,[m
[32m+[m[32m});[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mUse the configured Groq model from an environment variable when available:[m
[32m+[m
[32m+[m[32m```ts[m
[32m+[m[32mconst model = process.env.GROQ_MODEL ?? "llama-3.1-8b-instant";[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mThe request should use approximately:[m
[32m+[m
[32m+[m[32m```ts[m
[32m+[m[32mtemperature: 0;[m
[32m+[m[32mmax_completion_tokens: 300;[m
[32m+[m[32mresponse_format: {[m
[32m+[m[32m  type: "json_object";[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mRequire this JSON shape:[m
[32m+[m
[32m+[m[32m```json[m
[32m+[m[32m{[m
[32m+[m[32m  "primaryStyle": "one allowed existing style",[m
[32m+[m[32m  "descendingBassWeight": 0.0,[m
[32m+[m[32m  "complexity": 0.0,[m
[32m+[m[32m  "dissonanceTolerance": 0.0,[m
[32m+[m[32m  "cadenceStrength": 0.0,[m
[32m+[m[32m  "preferSevenths": false,[m
[32m+[m[32m  "preferSuspensions": false,[m
[32m+[m[32m  "mood": [],[m
[32m+[m[32m  "summary": ""[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mThe system prompt must state:[m
[32m+[m
[32m+[m[32m- Return only JSON.[m
[32m+[m[32m- Use only supported style names.[m
[32m+[m[32m- Do not return chord names.[m
[32m+[m[32m- Do not generate a progression.[m
[32m+[m[32m- Map simple/pop/clean/basic language toward the simple style.[m
[32m+[m[32m- Map jazz/lush/sophisticated/colorful language toward the jazzy style.[m
[32m+[m[32m- Map blues/gritty/dominant-seventh language toward the bluesy style.[m
[32m+[m[32m- Increase descending-bass weight for falling, walking-down, or descending bass requests.[m
[32m+[m[32m- Lower dissonance tolerance for safe, smooth, or consonant requests.[m
[32m+[m[32m- Raise dissonance tolerance for tense, surprising, or experimental requests.[m
[32m+[m[32m- Raise cadence strength for resolved, satisfying, or strong-ending requests.[m
[32m+[m
[32m+[m[32mImplement sanitization helpers that:[m
[32m+[m
[32m+[m[32m- Restrict `primaryStyle` to the existing allowed style values.[m
[32m+[m[32m- Clamp all numeric settings to `0–1`.[m
[32m+[m[32m- Accept only booleans for boolean fields.[m
[32m+[m[32m- Limit `mood` to at most five short strings.[m
[32m+[m[32m- Limit `summary` to 240 characters.[m
[32m+[m[32m- Substitute defaults for invalid or missing fields.[m
[32m+[m
[32m+[m[32mReturn a usable `InterpretedStyle` object even if the Groq request fails. Include an optional warning field if useful, but do not break the expected response shape.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m# Phase 5: Display Interpretation Before Changing Generation Logic[m
[32m+[m
[32m+[m[32mIn `Staff.tsx`, first add the text-prompt UI and display the interpreted settings without modifying scoring.[m
[32m+[m
[32m+[m[32mAdd state equivalent to:[m
[32m+[m
[32m+[m[32m```ts[m
[32m+[m[32mconst [stylePrompt, setStylePrompt] = useState("");[m
[32m+[m[32mconst [isGenerating, setIsGenerating] = useState(false);[m
[32m+[m[32mconst [aiInterpretation, setAiInterpretation] =[m
[32m+[m[32m  useState<InterpretedStyle | null>(null);[m
[32m+[m[32mconst [aiError, setAiError] = useState<string | null>(null);[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mAdd a text area near the current style controls:[m
[32m+[m
[32m+[m[32m```tsx[m
[32m+[m[32m<label className="flex flex-col gap-2">[m
[32m+[m[32m  <span className="text-sm font-medium">Describe the harmony you want</span>[m
[32m+[m
[32m+[m[32m  <textarea[m
[32m+[m[32m    value={stylePrompt}[m
[32m+[m[32m    onChange={(event) => setStylePrompt(event.target.value)}[m
[32m+[m[32m    maxLength={500}[m
[32m+[m[32m    rows={3}[m
[32m+[m[32m    placeholder="Warm and jazzy with a descending bass and a satisfying ending"[m
[32m+[m[32m    className="rounded-md border px-3 py-2"[m
[32m+[m[32m  />[m
[32m+[m[32m</label>[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mMatch the existing visual style instead of forcing these exact classes if the component already uses a consistent control style.[m
[32m+[m
[32m+[m[32mAdd a client helper that calls:[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mPOST /api/interpret-style[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mDisplay a compact interpretation summary such as:[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mInterpreted as: Jazzy · low dissonance · strong cadence · descending bass[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mAt the end of this phase, verify that:[m
[32m+[m
[32m+[m[32m- the prompt reaches the route[m
[32m+[m[32m- the route returns valid settings[m
[32m+[m[32m- the settings render correctly[m
[32m+[m[32m- existing chord generation remains unchanged[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m# Phase 6: Connect Preferences to the Music Engine Incrementally[m
[32m+[m
[32m+[m[32mDo not change all scoring behavior at once.[m
[32m+[m
[32m+[m[32m## Step 6A: Connect `primaryStyle`[m
[32m+[m
[32m+[m[32mUse `interpretation.primaryStyle` as the engine style when a non-empty prompt was interpreted successfully.[m
[32m+[m
[32m+[m[32mWhen the prompt is empty or interpretation fails, use the existing dropdown's `chordStyle`.[m
[32m+[m
[32m+[m[32mPreserve the current style dropdown as a manual fallback.[m
[32m+[m
[32m+[m[32m## Step 6B: Connect `descendingBassWeight`[m
[32m+[m
[32m+[m[32mUse the existing voicing or progression logic that already evaluates bass motion.[m
[32m+[m
[32m+[m[32mReward controlled downward motion when the weight is high.[m
[32m+[m
[32m+[m[32mSuggested behavior:[m
[32m+[m
[32m+[m[32m- Reward downward motion of approximately 1–5 semitones.[m
[32m+[m[32m- Do not reward very large drops merely because they descend.[m
[32m+[m[32m- Penalize upward motion only when the requested weight is meaningfully above zero.[m
[32m+[m[32m- Add a human-readable reason when the reward materially affects the score.[m
[32m+[m
[32m+[m[32mDo not introduce a second unrelated voicing system.[m
[32m+[m
[32m+[m[32m## Step 6C: Connect `cadenceStrength`[m
[32m+[m
[32m+[m[32mUse the existing cadence/path scoring.[m
[32m+[m
[32m+[m[32mScale bonuses for:[m
[32m+[m
[32m+[m[32m- V–I[m
[32m+[m[32m- IV–I[m
[32m+[m[32m- ending on tonic[m
[32m+[m[32m- other cadences already recognized by the engine[m
[32m+[m
[32m+[m[32mScale penalties for weak endings when cadence strength is high.[m
[32m+[m
[32m+[m[32mDo not hard-code major-only assumptions if the existing engine supports minor keys.[m
[32m+[m
[32m+[m[32m## Step 6D: Connect Complexity Preferences[m
[32m+[m
[32m+[m[32mUse the actual `ChordQuality` values already defined in the project.[m
[32m+[m
[32m+[m[32mPossible behavior:[m
[32m+[m
[32m+[m[32m- Reward sevenths when `preferSevenths` is true.[m
[32m+[m[32m- Reward suspensions when `preferSuspensions` is true.[m
[32m+[m[32m- Reward simple triads when complexity is low.[m
[32m+[m[32m- Penalize unnecessarily complex chords for explicitly simple prompts.[m
[32m+[m[32m- Keep style-specific scoring already present in the engine.[m
[32m+[m
[32m+[m[32mAdd grounded reasons such as:[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mUses a seventh chord to add the requested harmonic color.[m
[32m+[m[32mKeeps the harmony simple and direct.[m
[32m+[m[32mUses a suspension for gentle tension.[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m## Step 6E: Connect `dissonanceTolerance`[m
[32m+[m
[32m+[m[32mScale the existing non-chord-tone or melody-clash penalty.[m
[32m+[m
[32m+[m[32mUse behavior equivalent to:[m
[32m+[m
[32m+[m[32m```ts[m
[32m+[m[32mconst penaltyMultiplier = 1 - 0.8 * preferences.dissonanceTolerance;[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mThis means:[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32m0.0 → full penalty[m
[32m+[m[32m0.5 → reduced penalty[m
[32m+[m[32m1.0 → only 20% of the original penalty[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mDo not reduce the penalty to zero.[m
[32m+[m
[32m+[m[32mDo not invent a new dissonance system if the engine already has melody-fit calculations. Modify the existing penalty at its actual source.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m# Phase 7: Updat